{
    "claude-code": {
        "agents": {
            "source": "agents/",
            "target": "~/.claude/agents/",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                "**/*_tmp_*"
            ]
        },
        "skills": {
            "source": "skills/",
            "target": "~/.claude/skills/",
            "include": [
                "**/*.md",
                "**/*.yaml"
            ],
            "exclude": [
                "**/SKILL.cursor.additions.md",
                "**/*_tmp_*"
            ]
        },
        "hooks": {
            "source": "hooks/",
            "target": "~/.claude/hooks/",
            "include": [
                "**/*"
            ],
            "exclude": [
                "**/*_tmp_*"
            ]
        },
        "settings": {
            "source": ".",
            "target": "~/.claude/",
            "include": [
                "settings.json",
                "CLAUDE-root.md"
            ],
            "rename": {
                "CLAUDE-root.md": "CLAUDE.md"
            },
            "prune": false
        }
    },
    "claude-code-wsl": {
        "agents": {
            "source": "agents/",
            "target": "//wsl.localhost/Ubuntu-24.04/home/ubuntu/.claude/agents/",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                "**/*_tmp_*"
            ]
        },
        "skills": {
            "source": "skills/",
            "target": "//wsl.localhost/Ubuntu-24.04/home/ubuntu/.claude/skills/",
            "include": [
                "**/*.md",
                "**/*.yaml"
            ],
            "exclude": [
                "**/SKILL.cursor.additions.md",
                "**/*_tmp_*"
            ]
        },
        "hooks": {
            "source": "hooks/",
            "target": "//wsl.localhost/Ubuntu-24.04/home/ubuntu/.claude/hooks/",
            "include": [
                "**/*"
            ],
            "exclude": [
                "**/*_tmp_*"
            ]
        },
        "settings": {
            "source": ".",
            "target": "//wsl.localhost/Ubuntu-24.04/home/ubuntu/.claude/",
            "include": [
                "settings.json",
                "CLAUDE-root.md"
            ],
            "rename": {
                "CLAUDE-root.md": "CLAUDE.md"
            },
            "prune": false
        }
    },
    "cursor": {
        "agents": {
            "source": "agents/",
            "target": "~/.cursor/agents/",
            "include": [
                "**/*.md"
            ],
            "exclude": [
                "**/*_tmp_*"
            ],
            "transform": true
        },
        "rules": {
            "source": ".cursor/rules/",
            "target": "~/.cursor/rules/",
            "include": [
                "*.mdc"
            ],
            "exclude": [
                "documentation-sync.mdc",
                "**/*_tmp_*"
            ]
        },
        "skills": {
            "source": "skills/",
            "target": "~/.cursor/skills/",
            "include": [
                "**/*"
            ],
            "exclude": [
                "kickoff/**",
                "**/SKILL.cursor.additions.md",
                "**/SKILL.cursor.md",
                "**/*_tmp_*"
            ],
            "transform": true
        }
    }
}
